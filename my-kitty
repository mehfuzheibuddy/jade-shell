#!/usr/bin/env bash
set -euo pipefail

# ---------- Theme definitions ----------
declare -A THEMES=( [github-dark]=1 [dracula]=2 [gruvbox-dark]=3 [tokyo-night]=4 [catppuccin-mocha]=5 [osaka]=6 [jade]=7 [osaka-jade]=8 )

usage() { echo "Usage: ./my_shell.sh [--theme github-dark|dracula|gruvbox-dark|tokyo-night|catppuccin-mocha|osaka|jade|osaka-jade]"; }

THEME="${THEME:-}"
if [[ $# -gt 0 ]]; then
  case "$1" in
    --theme) THEME="${2:-}"; [[ -z "$THEME" || -z "${THEMES[$THEME]:-}" ]] && { usage; exit 1; } ;;
    *) usage; exit 1 ;;
  esac
fi
if [[ -z "$THEME" ]]; then
  echo "Choose a theme:"
  echo "  1) github-dark   2) dracula   3) gruvbox-dark   4) tokyo-night   5) catppuccin-mocha   6) osaka   7) jade   8) osaka-jade"
  read -r REPLY
  case "$REPLY" in
    1) THEME="github-dark" ;; 2) THEME="dracula" ;;
    3) THEME="gruvbox-dark" ;; 4) THEME="tokyo-night" ;;
    5) THEME="catppuccin-mocha" ;; 6) THEME="osaka" ;; 7) THEME="jade" ;;
    8) THEME="osaka-jade" ;;
    *) echo "Invalid choice."; exit 1 ;;
  esac
fi
echo "==> Using theme: $THEME"

