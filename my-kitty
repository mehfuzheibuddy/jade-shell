hex2rgb() { # #rrggbb -> r,g,b (starship style strings)
  local h="${1#\#}" r g b
  r=$((16#${h:0:2})); g=$((16#${h:2:2})); b=$((16#${h:4:2}))
  echo "$r,$g,$b"
}

echo "==> Step 1: Installing kitty terminal"
if ! command -v kitty >/dev/null 2>&1 && [ ! -d /Applications/kitty.app ]; then
  brew install --cask kitty
else
  echo "kitty already installed, skipping."
fi

echo "==> Step 2: Installing Starship prompt"
if ! command -v starship >/dev/null 2>&1; then
  curl -sS https://starship.rs/install.sh | sh -s -- --yes
else
  echo "Starship already installed, skipping."
fi

echo "==> Step 3: Installing Hack Nerd Font"
FONT_DIR="$HOME/Library/Fonts"
if ! ls "$FONT_DIR"/HackNerd* >/dev/null 2>&1; then
  curl -sL -o /tmp/hack.zip \
    "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Hack.zip"
  unzip -o /tmp/hack.zip -d "$FONT_DIR" -x "*Windows*" "*LICENSE*" >/dev/null
  rm -f /tmp/hack.zip
else
  echo "Hack Nerd Font already installed, skipping."
fi

echo "==> Step 4: Writing kitty config ($THEME)"
KITTY_DIR="$HOME/.config/kitty"
mkdir -p "$KITTY_DIR"

cat > "$KITTY_DIR/kitty.conf" <<CONF
# kitty configuration — $THEME
font_family      Hack Nerd Font
bold_font         auto
italic_font       auto
bold_italic_font  auto
font_size         13.0

window_padding_width    12
cursor_shape            beam
cursor_beam_unfocused   hollow
scrollback_lines        10000
enable_audio_bell       no
copy_on_select          yes
confirm_os_window_close 0
# Keep the native macOS titlebar so the window has a proper drag handle
hide_window_decorations no
macos_titlebar_color    background
macos_show_window_title_in window

include current-theme.conf
CONF

cat > "$KITTY_DIR/current-theme.conf" <<THEMECONF
# $THEME theme for kitty
foreground           $FGC
background           $BGC
selection_foreground $SELF
selection_background $SELBG
cursor               $CUR
url_color            $URL

color0  $C0
color8  $C8
color1  $C1
color9  $C9
color2  $C2
color10 $C10
color3  $C3
color11 $C11
color4  $C4
color12 $C12
color5  $C5
color13 $C13
color6  $C6
color14 $C14
color7  $C7
color15 $C15
THEMECONF

echo "==> Step 5: Writing Starship config ($THEME)"
mkdir -p "$HOME/.config"
cat > "$HOME/.config/starship.toml" <<TOML
# $THEME Starship theme
format = """
\$directory\$git_branch\$git_status\$nodejs\$python\$rust\$golang\$cmd_duration
\$character"""

[character]
success_symbol = "[❯](bold $(hex2rgb "$SOK"))"
error_symbol   = "[❯](bold $(hex2rgb "$SERR"))"

[directory]
style = "bold $(hex2rgb "$SDIR")"
read_only = " 🔒"
truncation_length = 3

[git_branch]
symbol = "🌱 "
style = "bold $(hex2rgb "$SBR")"

[git_status]
style = "bold $(hex2rgb "$SGI")"

[nodejs]
symbol = "⬢ "
style = "$(hex2rgb "$SOK")"

[python]
symbol = "🐍 "
style = "bold $(hex2rgb "$SGI")"

[rust]
symbol = "🦀 "
style = "bold $(hex2rgb "$STIME")"

[golang]
symbol = "🐹 "
style = "bold $(hex2rgb "$SDIR")"

[cmd_duration]
min_time = 2000
format = "took [\$duration](bold $(hex2rgb "$STIME")) "

[line_break]
disabled = true
TOML

echo "==> Step 6: Hooking Starship into zsh"
SHELL_RC="$HOME/.zshrc"
touch "$SHELL_RC"
if ! grep -q 'starship init' "$SHELL_RC"; then
  printf '\n# Starship prompt\neval "$(starship init zsh)"\n' >> "$SHELL_RC"
fi

echo "==> Done ($THEME)! Configured: kitty, Hack Nerd Font, Starship, zsh hook."
echo "Launch with: open -a kitty   | Reload config in kitty: ctrl+shift+f5"
